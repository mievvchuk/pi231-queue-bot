# Скопіюйте у .env для локального запуску або додайте ці ключі в Environment на хостингу.
# Справжні значення не комітьте. Змінні середовища мають пріоритет над файлом.

# ОБОВ'ЯЗКОВО: наявний токен, наявна база Neon та Telegram ID власника.
# Для DATABASE_URL використайте ТУ САМУ базу — це збереже черги та історію.
BOT_TOKEN=
DATABASE_URL=
OWNER_ID=

# Додаткові початкові адміни через кому. Порожньо — лише OWNER_ID.
# Застосовується лише коли таблиця admins порожня; чинні адміни не видаляються.
INITIAL_ADMIN_IDS=
# Необов'язково: ID групового чату, наприклад -100...; налаштування в БД має пріоритет.
GROUP_CHAT_ID=
STUDENT_GROUP=ПІ-231
TZ=Europe/Kyiv
NOTIFICATION_TIME=17:00

# Фото замін: disabled / auto / groq / openai. auto зберігає вибір за префіксом ключа.
RECOGNITION_PROVIDER=auto
RECOGNITION_API_KEY=
# Для сумісності також підтримується OPENAI_API_KEY, якщо RECOGNITION_API_KEY не заданий.
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_MODEL=gpt-4o-mini
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
RECOGNITION_TIMEOUT_SECONDS=45

# Хостинг зазвичай сам задає PORT. На Render залиште його значення від платформи.
HTTP_HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
POLLING_RETRY_SECONDS=5
POLLS_WATCH_INTERVAL=15
SCHEDULE_CHECK_INTERVAL=60


# Порожньо — наявний файл у корені, інакше data/subjects.json та data/schedule.json.
# Відносні шляхи рахуються від кореня проєкту, а не поточної папки запуску.
SUBJECTS_PATH=
SCHEDULE_PATH=
# Для окремого env-файла задайте ENV_FILE у середовищі ДО запуску.
# TEST_DATABASE_URL — лише для окремої тестової PostgreSQL, ніколи не робоча база.
